{
  "name": "E T H O S",
  "private": true,
  "version": "3.1.56",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:release": "npm run build && npm run release:receipt",
    "deploy": "npm run build && gh-pages -d dist -r https://github.com/aitherapp/ethos.git",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "release:receipt": "node scripts/write-release-receipt.mjs",
    "test": "vitest run",
    "test:live": "RUN_LIVE_RELAY_TESTS=1 vitest run tests/relay-roundtrip.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/simple-peer": "^9.11.9",
    "@vitejs/plugin-react": "^6.0.2",
    "bencode": "^4.0.0",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "crystals-kyber-js": "^2.7.0",
    "date-fns": "^4.1.0",
    "dns-packet": "^5.6.1",
    "emoji-picker-react": "^4.18.0",
    "gh-pages": "^6.3.0",
    "js-sha512": "^0.9.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nostr-tools": "^2.23.3",
    "peerjs": "^1.5.5",
    "pkarr": "^1.4.1",
    "process": "^0.11.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "simple-peer": "^9.11.1",
    "sodium-javascript": "^0.8.0",
    "tailwind-merge": "^3.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  }
}
