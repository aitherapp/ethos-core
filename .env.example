# Optional TURN credentials for production WebRTC relay fallback.
# See README "Optional TURN credentials" for details.
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_TURN_URLS=

# GitHub deployments use environment secrets instead of this file:
# - staging: STAGING_DEPLOY_KEY plus optional STAGING_TURN_URLS, STAGING_TURN_USERNAME, STAGING_TURN_CREDENTIAL
# - production: PRODUCTION_TURN_URLS, PRODUCTION_TURN_USERNAME, PRODUCTION_TURN_CREDENTIAL
