{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "push-gateway",
    "relay",
    "node_modules",
    "dist",
    "tests/pushGatewayAllowlist.test.ts",
    "tests/pushGatewaySetup.test.ts",
    "tests/relayAuth.test.ts",
    "tests/relayKinds.test.ts",
    "tests/relayRateLimit.test.ts",
    "tests/relayFilterMatch.test.ts"
  ]
}
